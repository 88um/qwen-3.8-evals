#!/usr/bin/env python3
"""Webhook consumer with background canonical reconciliation."""

import json
import os
import sqlite3
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

PORT = int(os.environ.get("PORT", "9200"))
STATE_DIR = os.environ.get("INBOX_STATE_DIR", "./state")
PROVIDER_URL = os.environ.get("PROVIDER_URL", "http://127.0.0.1:8090").rstrip("/")

_local = threading.local()


def get_db():
    if not hasattr(_local, "db"):
        db = sqlite3.connect(
            os.path.join(STATE_DIR, "inbox.db"),
            timeout=30,
            isolation_level=None,
        )
        db.execute("PRAGMA journal_mode=WAL")
        db.execute("PRAGMA synchronous=FULL")
        db.execute("PRAGMA busy_timeout=30000")
        db.row_factory = sqlite3.Row
        _local.db = db
    return _local.db


def init_db():
    os.makedirs(STATE_DIR, exist_ok=True)
    db = sqlite3.connect(
        os.path.join(STATE_DIR, "inbox.db"), isolation_level=None
    )
    db.execute("PRAGMA journal_mode=WAL")
    db.execute("PRAGMA synchronous=FULL")
    db.executescript("""
        CREATE TABLE IF NOT EXISTS events (
            event_id TEXT PRIMARY KEY,
            account_id TEXT NOT NULL,
            plan TEXT NOT NULL,
            status TEXT NOT NULL,
            created_at REAL NOT NULL
        );
        CREATE TABLE IF NOT EXISTS accounts (
            account_id TEXT PRIMARY KEY,
            plan TEXT NOT NULL,
            status TEXT NOT NULL,
            updated_at REAL NOT NULL DEFAULT 0
        );
        CREATE TABLE IF NOT EXISTS dirty (
            account_id TEXT PRIMARY KEY
        );
        CREATE INDEX IF NOT EXISTS idx_events_account
            ON events(account_id);
    """)
    db.close()


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        p = urlparse(self.path)
        if p.path == "/health":
            self._json(200, {"ok": True})
        elif p.path == "/state/all":
            db = get_db()
            rows = db.execute(
                "SELECT account_id, plan, status FROM accounts"
            ).fetchall()
            accounts = {
                r["account_id"]: {"plan": r["plan"], "status": r["status"]}
                for r in rows
            }
            self._json(200, {"accounts": accounts})
        else:
            self._json(404, {"error": "not found"})

    def do_POST(self):
        p = urlparse(self.path)
        if p.path == "/webhook":
            self._webhook()
        else:
            self._json(404, {"error": "not found"})

    def _webhook(self):
        n = int(self.headers.get("Content-Length", 0))
        raw = self.rfile.read(n) if n else b"{}"
        try:
            body = json.loads(raw)
        except (json.JSONDecodeError, ValueError):
            return self._json(400, {"error": "bad json"})

        event_id = body.get("event_id")
        account_id = body.get("account_id")
        data = body.get("data", {})
        plan = data.get("plan", "")
        status = data.get("status", "")
        created_at = body.get("created_at", 0.0)

        db = get_db()
        try:
            db.execute("BEGIN IMMEDIATE")
            dup = db.execute(
                "SELECT 1 FROM events WHERE event_id=?", (event_id,)
            ).fetchone()
            if dup:
                db.execute("COMMIT")
                return self._json(200, {"ok": True})
            db.execute(
                "INSERT INTO events VALUES(?,?,?,?,?)",
                (event_id, account_id, plan, status, created_at),
            )
            acct = db.execute(
                "SELECT updated_at FROM accounts WHERE account_id=?",
                (account_id,),
            ).fetchone()
            if not acct:
                db.execute(
                    "INSERT INTO accounts VALUES(?,?,?,?)",
                    (account_id, plan, status, created_at),
                )
            elif created_at > acct["updated_at"]:
                db.execute(
                    "UPDATE accounts SET plan=?, status=?, updated_at=? "
                    "WHERE account_id=?",
                    (plan, status, created_at, account_id),
                )
            db.execute(
                "INSERT OR IGNORE INTO dirty(account_id) VALUES(?)",
                (account_id,),
            )
            db.execute("COMMIT")
        except Exception:
            try:
                db.execute("ROLLBACK")
            except Exception:
                pass
            return self._json(500, {"error": "internal"})
        self._json(200, {"ok": True})


def reconcile_loop():
    db = sqlite3.connect(
        os.path.join(STATE_DIR, "inbox.db"),
        timeout=30,
        isolation_level=None,
    )
    db.execute("PRAGMA journal_mode=WAL")
    db.execute("PRAGMA synchronous=FULL")
    db.execute("PRAGMA busy_timeout=30000")
    db.row_factory = sqlite3.Row

    call_times = []

    while True:
        time.sleep(0.5)
        try:
            dirty = [
                r["account_id"]
                for r in db.execute("SELECT account_id FROM dirty").fetchall()
            ]
        except Exception:
            continue

        for account_id in dirty:
            now = time.time()
            call_times[:] = [t for t in call_times if now - t < 60]
            if len(call_times) >= 18:
                break

            try:
                url = f"{PROVIDER_URL}/subscription?account_id={account_id}"
                req = urllib.request.Request(url)
                with urllib.request.urlopen(req, timeout=5) as resp:
                    data = json.loads(resp.read())
                call_times.append(time.time())
            except urllib.error.HTTPError as e:
                call_times.append(time.time())
                if e.code == 429:
                    try:
                        info = json.loads(e.read())
                        time.sleep(info.get("retry_after", 5))
                    except Exception:
                        time.sleep(5)
                continue
            except Exception:
                continue

            try:
                db.execute("BEGIN IMMEDIATE")
                db.execute(
                    "INSERT OR REPLACE INTO accounts VALUES(?,?,?,?)",
                    (account_id, data["plan"], data["status"], 1e18),
                )
                db.execute(
                    "DELETE FROM dirty WHERE account_id=?", (account_id,)
                )
                db.execute("COMMIT")
            except Exception:
                try:
                    db.execute("ROLLBACK")
                except Exception:
                    pass


def main():
    init_db()
    threading.Thread(target=reconcile_loop, daemon=True).start()
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    srv.daemon_threads = True
    print(f"inbox serving on :{PORT}", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "serve":
        main()
    else:
        print("Usage: ./inbox serve", file=sys.stderr)
        sys.exit(1)
