#!/usr/bin/env python3
import json
import os
import sqlite3
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

DB_PATH = None

SCHEMA = """
CREATE TABLE IF NOT EXISTS ledger (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    kind TEXT NOT NULL,
    account_id TEXT,
    amount INTEGER,
    ref TEXT,
    key TEXT
);
CREATE TABLE IF NOT EXISTS accounts (
    account_id TEXT PRIMARY KEY,
    balance INTEGER NOT NULL,
    held INTEGER NOT NULL
);
CREATE TABLE IF NOT EXISTS hold_state (
    ref TEXT PRIMARY KEY,
    account_id TEXT NOT NULL,
    amount INTEGER NOT NULL,
    status TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS topup_keys (
    key TEXT PRIMARY KEY,
    account_id TEXT NOT NULL,
    amount INTEGER NOT NULL
);
"""


def connect():
    c = sqlite3.connect(DB_PATH, timeout=30, isolation_level=None)
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA synchronous=FULL")
    c.execute("PRAGMA busy_timeout=30000")
    return c


def _rollback(c):
    try:
        c.execute("ROLLBACK")
    except sqlite3.Error:
        pass


def run_mutating(fn):
    last = None
    for _ in range(5):
        c = connect()
        try:
            c.execute("BEGIN IMMEDIATE")
            outcome = fn(c)
            c.execute("COMMIT")
            return outcome
        except sqlite3.IntegrityError as e:
            last = e
            _rollback(c)
        except Exception:
            _rollback(c)
            raise
        finally:
            c.close()
    raise RuntimeError("write contention: %r" % (last,))


def _str(b, name):
    v = b.get(name)
    return v if isinstance(v, str) and v else None


def _posint(b, name):
    v = b.get(name)
    if isinstance(v, bool) or not isinstance(v, int) or v <= 0:
        return None
    return v


def op_account(b):
    acct = _str(b, "account_id")
    initial = _posint(b, "initial")
    if acct is None or initial is None:
        return 400, {"error": "bad_request"}

    def txn(c):
        if c.execute("SELECT 1 FROM accounts WHERE account_id = ?", (acct,)).fetchone():
            return 200, {"account_id": acct, "replayed": True}
        c.execute(
            "INSERT INTO accounts (account_id, balance, held) VALUES (?, ?, 0)",
            (acct, initial),
        )
        c.execute(
            "INSERT INTO ledger (kind, account_id, amount, ref, key) VALUES ('account_open', ?, ?, NULL, NULL)",
            (acct, initial),
        )
        return 200, {"account_id": acct, "replayed": False}

    return run_mutating(txn)


def op_topup(b):
    acct = _str(b, "account_id")
    amount = _posint(b, "amount")
    key = _str(b, "key")
    if acct is None or amount is None or key is None:
        return 400, {"error": "bad_request"}

    def txn(c):
        if not c.execute("SELECT 1 FROM accounts WHERE account_id = ?", (acct,)).fetchone():
            return 404, {"error": "not_found"}
        if c.execute("SELECT 1 FROM topup_keys WHERE key = ?", (key,)).fetchone():
            return 200, {"ok": True, "replayed": True}
        c.execute(
            "INSERT INTO topup_keys (key, account_id, amount) VALUES (?, ?, ?)",
            (key, acct, amount),
        )
        c.execute("UPDATE accounts SET balance = balance + ? WHERE account_id = ?", (amount, acct))
        c.execute(
            "INSERT INTO ledger (kind, account_id, amount, ref, key) VALUES ('topup', ?, ?, NULL, ?)",
            (acct, amount, key),
        )
        return 200, {"ok": True, "replayed": False}

    return run_mutating(txn)


def op_hold(b):
    acct = _str(b, "account_id")
    amount = _posint(b, "amount")
    ref = _str(b, "ref")
    if acct is None or amount is None or ref is None:
        return 400, {"error": "bad_request"}

    def txn(c):
        row = c.execute(
            "SELECT account_id, amount, status FROM hold_state WHERE ref = ?", (ref,)
        ).fetchone()
        if row:
            if row[0] == acct and row[1] == amount:
                return 200, {"held": True, "replayed": True}
            return 409, {"error": "duplicate_ref"}
        acct_row = c.execute(
            "SELECT balance, held FROM accounts WHERE account_id = ?", (acct,)
        ).fetchone()
        if not acct_row:
            return 404, {"error": "not_found"}
        if acct_row[0] - acct_row[1] < amount:
            return 409, {"error": "insufficient"}
        c.execute(
            "INSERT INTO hold_state (ref, account_id, amount, status) VALUES (?, ?, ?, 'open')",
            (ref, acct, amount),
        )
        c.execute("UPDATE accounts SET held = held + ? WHERE account_id = ?", (amount, acct))
        c.execute(
            "INSERT INTO ledger (kind, account_id, amount, ref, key) VALUES ('hold', ?, ?, ?, NULL)",
            (acct, amount, ref),
        )
        return 200, {"held": True, "replayed": False}

    return run_mutating(txn)


def op_terminal(b, kind):
    ref = _str(b, "ref")
    if ref is None:
        return 400, {"error": "bad_request"}
    other = "release" if kind == "charge" else "charge"
    label = "charged" if kind == "charge" else "released"

    def txn(c):
        row = c.execute(
            "SELECT account_id, amount, status FROM hold_state WHERE ref = ?", (ref,)
        ).fetchone()
        if not row:
            return 404, {"error": "not_found"}
        acct_id, amount, status = row
        if status == kind:
            return 200, {label: True, "replayed": True}
        if status == other:
            return 409, {"error": other}
        c.execute("UPDATE hold_state SET status = ? WHERE ref = ?", (kind, ref))
        if kind == "charge":
            c.execute(
                "UPDATE accounts SET balance = balance - ?, held = held - ? WHERE account_id = ?",
                (amount, amount, acct_id),
            )
        else:
            c.execute(
                "UPDATE accounts SET held = held - ? WHERE account_id = ?",
                (amount, acct_id),
            )
        c.execute(
            "INSERT INTO ledger (kind, account_id, amount, ref, key) VALUES (?, ?, ?, ?, NULL)",
            (kind, acct_id, amount, ref),
        )
        return 200, {label: True, "replayed": False}

    return run_mutating(txn)


def op_get_account(acct):
    if not acct:
        return 400, {"error": "bad_request"}
    c = connect()
    try:
        row = c.execute(
            "SELECT balance, held FROM accounts WHERE account_id = ?", (acct,)
        ).fetchone()
    finally:
        c.close()
    if not row:
        return 404, {"error": "not_found"}
    return 200, {"balance": row[0], "available": row[0] - row[1]}


def op_get_ledger():
    c = connect()
    try:
        rows = c.execute(
            "SELECT seq, kind, account_id, ref, amount, key FROM ledger ORDER BY seq"
        ).fetchall()
    finally:
        c.close()
    entries = [
        {"seq": r[0], "kind": r[1], "account_id": r[2], "ref": r[3], "amount": r[4], "key": r[5]}
        for r in rows
    ]
    return 200, {"entries": entries}


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "mini-ledger"

    def log_message(self, fmt, *args):
        pass

    def _send(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = 0
        raw = self.rfile.read(length) if length > 0 else b""
        try:
            body = json.loads(raw) if raw else {}
            if not isinstance(body, dict):
                raise ValueError
        except Exception:
            return self._send(400, {"error": "bad_json"})
        path = urlparse(self.path).path
        try:
            if path == "/account":
                code, obj = op_account(body)
            elif path == "/topup":
                code, obj = op_topup(body)
            elif path == "/hold":
                code, obj = op_hold(body)
            elif path == "/charge":
                code, obj = op_terminal(body, "charge")
            elif path == "/release":
                code, obj = op_terminal(body, "release")
            else:
                code, obj = 404, {"error": "not_found"}
        except Exception:
            code, obj = 500, {"error": "internal"}
        self._send(code, obj)

    def do_GET(self):
        parsed = urlparse(self.path)
        try:
            if parsed.path == "/account":
                qs = parse_qs(parsed.query)
                code, obj = op_get_account(qs.get("account_id", [""])[0])
            elif parsed.path == "/ledger":
                code, obj = op_get_ledger()
            else:
                code, obj = 404, {"error": "not_found"}
        except Exception:
            code, obj = 500, {"error": "internal"}
        self._send(code, obj)


def serve():
    global DB_PATH
    state_dir = os.environ.get("LEDGER_STATE_DIR")
    if not state_dir:
        print("LEDGER_STATE_DIR is required", file=sys.stderr)
        return 1
    os.makedirs(state_dir, exist_ok=True)
    DB_PATH = os.path.join(state_dir, "ledger.db")
    c = connect()
    try:
        c.executescript(SCHEMA)
    finally:
        c.close()
    port = int(os.environ.get("PORT", "0"))
    srv = ThreadingHTTPServer(("0.0.0.0", port), Handler)
    srv.daemon_threads = True
    srv.serve_forever()
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "serve":
        sys.exit(serve())
    print("usage: ledger serve", file=sys.stderr)
    sys.exit(2)


if __name__ == "__main__":
    main()
